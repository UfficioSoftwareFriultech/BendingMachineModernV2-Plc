<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_HmiCmd" Id="{bb01697b-cdad-4e05-9824-719152ad5ecb}">
    <Declaration><![CDATA[// Comando dell'HMI (HMI -> PLC). L'HMI scrive i campi e per ultimo incrementa nSeq.
TYPE ST_HmiCmd :
STRUCT
	nSeq			: UDINT;		// cambia a ogni nuovo comando
	eCommand		: E_HmiCommand;
	nAxis			: UINT;			// asse (indice di Hmi.Cfg.aAxis) per Calibrate
	nValue			: DINT;			// valore intero (SetCount)
	fValue			: LREAL;		// valore reale (quota di Calibrate)
	bFlag			: BOOL;			// opzione (Calibrate: usa fValue)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
