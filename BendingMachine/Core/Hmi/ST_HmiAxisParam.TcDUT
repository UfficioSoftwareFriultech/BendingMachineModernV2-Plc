<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_HmiAxisParam" Id="{cd0f994a-7c93-43e9-a3ed-7b463f080d3c}">
    <Declaration><![CDATA[// Parametri macchina di un asse scritti dall'HMI (Hmi.Param.aAxis, applicati con il comando WriteParameters).
TYPE ST_HmiAxisParam :
STRUCT
	bPresent		: BOOL;
	bCalibrated		: BOOL;
	bCheckDone		: BOOL;			// posizione verificata dopo l'accensione
	fUpperLimit		: LREAL;		// finecorsa software massimo
	fLowerLimit		: LREAL;		// finecorsa software minimo
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
